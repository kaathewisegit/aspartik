{
	"files": {
		"includes": ["*.json", "*.ts", "src/**/*.ts", "src/**/*.astro"]
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"lineWidth": 80,
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"indentStyle": "tab"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentWidth": 8,
			"indentStyle": "tab"
		}
	},
	"linter": {
		"rules": {
			"nursery": { "useSortedClasses": "error" },
			"suspicious": { "noUnknownAtRules": "off" }
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
