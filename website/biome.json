{
	"files": {
		"includes": [
			"*.json",
			"*.ts",
			"src/**/*.ts",
			"src/**/*.tsx",
			"src/**/*.astro"
		]
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noUnknownAtRules": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
