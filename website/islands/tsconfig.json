{
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],

		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",

		"strict": true,
		"types": ["vite/client"]
	}
}
