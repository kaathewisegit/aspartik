---
import "../style.css"

interface Props {
	class: string
}

const { class: cls } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Aspartik</title>
	</head>
	<body class={cls}>
		<slot />
	</body>
</html>
