---
import { getCollection } from "astro:content"
import { Module } from "../../../components/pdoc"
import Layout from "../../../layouts/Html.astro"
import type { ModuleType } from "../../../schema"

export async function getStaticPaths() {
	const modules = await getCollection("reference")

	const out = []
	for (const module of modules) {
		const url = module.id.replaceAll(".", "/")
		out.push({
			params: { slug: url },
			props: module,
		})
	}

	return out
}

interface Props {
	data: ModuleType
}

const { data: module } = Astro.props

const renderedModule = Module(module)
---

<Layout>
	<Fragment set:html={renderedModule} />
</Layout>
