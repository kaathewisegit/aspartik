---
import Layout from "../layouts/Html.astro"
---

<Layout>
	<artcile>
		<section
			class="flex min-h-screen min-w-screen flex-col items-center justify-center"
		>
			<h1 class="mx-auto max-w-fit text-9xl font-medium">
				Aspartik b3
			</h1>
			<p class="mt-8 text-4xl font-light">
				<span class="casl italic">Fast</span>
				and
				<span class="casl italic">efficient</span>
				Bayesian phylogenetic analysis
			</p>

			<nav
				class="absolute top-0 right-0 mt-4 mr-8 flex flex-col space-y-2 text-2xl"
			>
				<a href="/docs/">Documentation</a>
				<a
					href="https://github.com/kaathewisegit/aspartik/"
				>
					Source code
				</a>
			</nav>
		</section>
	</artcile>
</Layout>
